# ──────────────────────────────────────────────────────────────────
# IncuBrix – Environment Variables
# Copy to .env and adjust values. NEVER commit .env itself.
# ──────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false
API_TOKEN=                    # Bearer token for auth; empty = no auth
RATE_LIMIT_PER_MINUTE=60      # Max requests per minute per client

# ── Database (Postgres) ─────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://incubrix:incubrix@postgres:5432/incubrix
DATABASE_URL_ASYNC=postgresql+asyncpg://incubrix:incubrix@postgres:5432/incubrix
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ── S3 / MinIO ──────────────────────────────────────────────────
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=incubrix
S3_REGION=us-east-1
S3_PRESIGNED_EXPIRY=3600      # Presigned URL expiry in seconds

# ── STT Adapter ─────────────────────────────────────────────────
STT_PROVIDER=mock             # mock | faster_whisper
STT_MODEL=base                # Whisper model size

# ── LLM Adapter (instruction parsing only) ──────────────────────
LLM_PROVIDER=mock             # mock | groq | openai
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=                 # Required if LLM_PROVIDER=groq
OPENAI_API_KEY=               # Required if LLM_PROVIDER=openai

# ── Embedder Adapter ────────────────────────────────────────────
EMBEDDER_PROVIDER=mock        # mock | local
EMBEDDER_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Engine Limits ───────────────────────────────────────────────
MIN_SPEED=0.25                # Minimum speed factor
MAX_SPEED=4.0                 # Maximum speed factor
MIN_CAPTION_S=0.7             # Minimum caption display time (seconds)
LOW_CONFIDENCE_THRESHOLD=0.6  # Words below this are flagged

# ── Upload Limits ───────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=500
URL_FETCH_TIMEOUT_S=120
URL_FETCH_MAX_SIZE_MB=500

# ── Jobs / Callbacks ────────────────────────────────────────────
WORKER_POLL_INTERVAL_S=1.0
WORKER_CONCURRENCY=2
HMAC_SECRET=change-me-in-production  # HMAC-SHA256 for callback signing
CALLBACK_MAX_RETRIES=3
CALLBACK_BACKOFF_S=2.0

# ── Logging ─────────────────────────────────────────────────────
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json               # json | console

# ── Cost Estimation ─────────────────────────────────────────────
STT_COST_PER_MINUTE=0.006
LLM_COST_PER_1K_TOKENS=0.0008

# ── Misc ────────────────────────────────────────────────────────
TEST_MODE=false               # Enables file:// URL intake in tests
