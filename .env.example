# ──────────────────────────────────────────────────────────────────
# IncuBrix – Environment Variables
# Copy to .env and adjust values. NEVER commit .env itself.
# ──────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false
API_TOKEN=replace-with-a-random-token  # Required at runtime
AUTH_DISABLED=false                    # Explicit local/test-only bypass; never enable in prod
RATE_LIMIT_PER_MINUTE=60               # Max requests per minute per client
MAX_UPLOAD_BYTES=524288000             # Maximum multipart upload size in bytes

# ── Database (Postgres) ─────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://incubrix:incubrix@postgres:5432/incubrix
DATABASE_URL_ASYNC=postgresql+psycopg2://incubrix:incubrix@postgres:5432/incubrix
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ── S3 / MinIO ──────────────────────────────────────────────────
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=replace-with-a-random-access-key
S3_SECRET_KEY=replace-with-a-random-storage-secret
S3_BUCKET=incubrix
S3_REGION=us-east-1
S3_PRESIGNED_EXPIRY=3600      # Presigned URL expiry in seconds

# ── STT Adapter ─────────────────────────────────────────────────
STT_PROVIDER=mock             # mock | faster_whisper
STT_MODEL=                    # Whisper model name when faster_whisper is selected
STT_DEVICE=cpu                # cpu | cuda

# ── LLM Adapter (instruction parsing only) ──────────────────────
LLM_PROVIDER=mock             # mock | groq | openai
LLM_MODEL=                    # Required when a hosted LLM provider is selected
LLM_BASE_URL=                 # OpenAI-compatible endpoint when a hosted provider is selected
LLM_API_KEY=                  # Optional OpenAI-compatible API key
GROQ_API_KEY=                 # Required if LLM_PROVIDER=groq
OPENAI_API_KEY=               # Required if LLM_PROVIDER=openai
LLM_TIMEOUT_S=30              # Per-request HTTP timeout
LLM_MAX_RETRIES=2             # Retries for timeout, 429 and 5xx errors

# ── Embedder Adapter ────────────────────────────────────────────
EMBEDDER_PROVIDER=mock        # mock | local
EMBEDDER_MODEL=               # Required when the local embedder is selected
EMBEDDER_DIMENSIONS=128       # Mock embedder vector size

# ── Engine Limits ───────────────────────────────────────────────
MIN_SPEED=0.25                # Minimum speed factor
MAX_SPEED=4.0                 # Maximum speed factor
MIN_CAPTION_S=0.7             # Minimum caption display time (seconds)
LOW_CONFIDENCE_THRESHOLD=0.6  # Words below this are flagged

# ── Upload Limits ───────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=500
URL_FETCH_TIMEOUT_S=120
URL_FETCH_MAX_SIZE_MB=500
MAX_DOWNLOAD_BYTES=524288000  # Maximum bytes fetched from URL intake
URL_MAX_REDIRECTS=3           # Maximum HTTPS redirects followed

# ── Jobs / Callbacks ────────────────────────────────────────────
WORKER_POLL_INTERVAL_S=1.0
WORKER_CONCURRENCY=2
HMAC_SECRET=replace-with-a-random-hmac-secret
CALLBACK_HMAC_SECRET=replace-with-a-random-callback-secret
CALLBACK_MAX_RETRIES=3
CALLBACK_BACKOFF_S=2.0
JOB_MAX_ATTEMPTS=3            # Attempts before a background job fails permanently
JOB_HEARTBEAT_STALE_S=120     # Seconds without a worker heartbeat before recovery
IDEMPOTENCY_TTL_S=86400       # Lifetime of saved POST responses
STT_MOCK_TRANSCRIPT_PATH=     # Optional prepared transcript JSON used by mock STT

# ── Logging ─────────────────────────────────────────────────────
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json               # json | console

# ── Cost Estimation ─────────────────────────────────────────────
STT_COST_PER_MINUTE=0.0           # mock/local = 0; set to hosted provider's price (e.g. 0.006)
LLM_COST_PER_1K_TOKENS=0.0
LLM_INPUT_COST_PER_1K_TOKENS=0.0
LLM_OUTPUT_COST_PER_1K_TOKENS=0.0

# ── Misc ────────────────────────────────────────────────────────
TEST_MODE=false               # Enables file:// URL intake in tests